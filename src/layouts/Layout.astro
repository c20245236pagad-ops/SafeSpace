---
interface Props {
  title?: string;
}

const { title = "SafeSpace" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">SafeSpace</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} SafeSpace</p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  nav,
  footer {
    padding: 1rem;
  }

  main {
    min-height: 70vh;
  }
</style>