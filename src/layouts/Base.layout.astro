---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rosa Perequin & Ronalyn Pagad | Team Résumé",
  description = "A team résumé for Rosa Perequin and Ronalyn Pagad.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151515" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Go to homepage">
          <span class="brand-mark">RP</span>
          <span>Rosa + Ronalyn</span>
        </a>
        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#team">Team</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </div>
        <a class="nav-cta" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Rosa Perequin &amp; Ronalyn Pagad · Team résumé</p>
      <p>&copy; {new Date().getFullYear()} · Replace bracketed details before publishing</p>
    </footer>
  </body>
</html>