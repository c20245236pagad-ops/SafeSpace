<section class="contact" id="contact">
  <div class="contact-copy">
    <p class="eyebrow">05 / Get in touch</p>
    <h2>Have a good idea?<br /><em>Let’s talk.</em></h2>
    <p class="contact-intro">Send us a note about what you have in mind.</p>
  </div>
  <form class="contact-form" id="contact-form">
    <label>
      <span>Name</span>
      <input type="text" name="name" placeholder="Your name" autocomplete="name" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
    </label>
    <label>
      <span>Write message</span>
      <textarea name="message" rows="4" placeholder="Tell us what you have in mind..." required></textarea>
    </label>
    <button type="submit">Send inquiry <span aria-hidden="true">↗</span></button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const recipient = "replace-with-your-email@example.com";

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const status = form.querySelector<HTMLElement>(".form-status");
    if (recipient === "replace-with-your-email@example.com") {
      if (status) {
        status.textContent = "Add your email address in Contact.astro to enable message delivery.";
      }
      return;
    }

    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const email = String(data.get("email") ?? "");
    const message = String(data.get("message") ?? "");
    const subject = `Portfolio inquiry from ${name}`;
    const body = `${message}\n\nFrom: ${name}\nEmail: ${email}`;

    window.location.href = `mailto:${recipient}?${new URLSearchParams({ subject, body }).toString()}`;
    if (status) {
      status.textContent = "Opening your email app to send the inquiry.";
    }
  });
</script>

<style>
  .contact { width: min(1120px, calc(100% - 48px)); margin: 0 auto 100px; display: grid; grid-template-columns: 1fr 0.78fr; gap: 10%; padding: 82px; border-radius: 12px; background: var(--ink); color: #f7f6ef; }
  .eyebrow { margin: 0 0 28px; color: #aaa99f; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  h2 { margin: 0; font-size: clamp(3.2rem, 6vw, 6.2rem); line-height: 0.94; letter-spacing: -0.07em; }
  h2 em { color: var(--acid); font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  .contact-intro { max-width: 380px; margin: 26px 0 0; color: #c4c3b9; line-height: 1.65; }
  .contact-form, .contact-form label { display: grid; }
  .contact-form { gap: 18px; }
  .contact-form label { gap: 8px; }
  .contact-form label span { color: #aaa99f; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  input, textarea { width: 100%; border: 0; border-bottom: 1px solid #52524c; border-radius: 0; outline: none; background: transparent; color: white; padding: 8px 0 14px; resize: vertical; }
  input:focus, textarea:focus { border-color: var(--acid); }
  input::placeholder, textarea::placeholder { color: #77776f; }
  button { min-height: 52px; display: flex; align-items: center; justify-content: space-between; margin-top: 8px; border: 0; border-radius: 4px; background: var(--acid); color: var(--ink); padding: 0 18px; cursor: pointer; font-weight: 850; }
  .form-status { min-height: 1.4em; margin: 0; color: #c4c3b9; font-size: 0.82rem; line-height: 1.5; }

  @media (max-width: 900px) {
    .contact { grid-template-columns: 1fr; gap: 42px; padding: 56px 36px; }
  }

  @media (max-width: 700px) {
    .contact { width: calc(100% - 32px); margin-bottom: 48px; padding: 48px 24px; }
  }
</style>
